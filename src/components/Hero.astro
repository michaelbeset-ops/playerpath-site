---
import Button from "./Button.astro";
import Screen from "./Screen.astro";
import BrowserFrame from "./BrowserFrame.astro";
import VisualDashboard from "./VisualDashboard.astro";
import CollectibleCard from "./CollectibleCard.astro";
import PitchLines from "./PitchLines.astro";
import { kaarten } from "../data/spelers";

// De hero: tekst links, het product rechts, allebei in het eerste scherm.
// Het dashboard kantelt licht naar achteren, zodat het voelt als een echt
// product in plaats van een plaatje, maar blijft in zijn geheel in beeld.
const goud = kaarten.find((kaart) => kaart.level === "goud")!;

const feiten = [
  { waarde: "€89", label: "vanaf per maand" },
  { waarde: "30 sec", label: "per rapport" },
  { waarde: "€0", label: "opstartkosten" },
];
---

<section class="relative isolate overflow-hidden bg-ink">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <PitchLines
      class="text-white/[0.06] [mask-image:radial-gradient(ellipse_55%_70%_at_72%_50%,black,transparent_75%)]"
    />
    <div class="absolute -left-48 top-16 h-[36rem] w-[36rem] rounded-full bg-accent/[0.12] blur-[140px]"></div>
    <div
      class="absolute -right-24 bottom-[-6rem] h-[30rem] w-[42rem] rounded-full bg-[#38bdf8]/[0.07] blur-[140px]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
  </div>

  <div
    class="mx-auto grid max-w-7xl items-center gap-x-10 gap-y-4 px-5 pb-16 [&>*]:min-w-0 pt-0 sm:gap-y-16 sm:px-8 sm:pb-20 sm:pt-20 lg:min-h-[min(52rem,calc(100svh-4rem))] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:pb-24 lg:pt-16"
  >
    <!-- Op een telefoon vult de tekst het eerste scherm; het product volgt bij het scrollen. -->
    <div
      class="relative z-10 text-center max-sm:flex max-sm:min-h-[calc(100svh-4rem)] max-sm:flex-col max-sm:justify-center max-sm:py-8 lg:text-left"
    >
      <a
        href="#spelerskaart"
        class="group max-sm:hidden inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.04] py-1 pl-1 pr-3.5 text-[13px] text-white/75 transition-colors duration-200 hover:border-white/25 hover:text-white"
      >
        <span class="rounded-full bg-accent px-2 py-0.5 text-[11px] font-semibold text-ink">Nieuw</span>
        Elke speler zijn eigen kaart
        <svg
          class="btn-arrow size-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <h1
        class="text-balance text-[2.7rem] font-semibold sm:mt-7 leading-[1.03] tracking-[-0.035em] text-white sm:text-6xl lg:text-[3.9rem] xl:text-[4.4rem]"
      >
        Minder administratie.
        <span
          class="block bg-gradient-to-r from-[#86efac] via-accent to-[#bef264] bg-clip-text pb-1 text-transparent"
        >
          Betere spelers.
        </span>
      </h1>

      <p class="mx-auto mt-5 max-w-xl text-pretty text-base leading-relaxed text-white/60 sm:mt-6 sm:text-lg lg:mx-0">
        PlayerPath regelt inschrijvingen, incasso, rooster en aanwezigheid voor keeper- en
        voetbalscholen. En elke speler krijgt een kaart die groeit met elk rapport.
      </p>

      <div
        class="mt-8 flex flex-col items-center gap-4 sm:mt-9 sm:flex-row sm:justify-center sm:gap-7 lg:justify-start"
      >
        <Button href="#proef-aanvragen" size="lg" class="max-sm:w-full max-sm:justify-between">Plan een demo</Button>
        <a
          href="#tijdwinst"
          class="group inline-flex items-center gap-2 text-[15px] font-semibold text-white/75 transition-colors hover:text-white"
        >
          Bereken je tijdwinst
          <svg
            class="btn-arrow size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <dl class="mx-auto mt-10 grid w-full max-w-md grid-cols-3 border-t border-white/10 pt-6 sm:mt-12 lg:mx-0">
        {
          feiten.map((feit, i) => (
            <div class={`flex flex-col-reverse max-sm:text-center ${i > 0 ? "border-l border-white/10 sm:pl-6" : ""}`}>
              <dt class="mt-1 text-xs text-white/45">{feit.label}</dt>
              <dd class="text-xl font-semibold tracking-tight text-white sm:text-2xl">{feit.waarde}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative max-lg:mb-4">
      <div class="[perspective:2200px]">
        <div class="hero-kantel">
          <Screen
            name="dashboard"
            alt="Het dashboard van PlayerPath met spelers, rapporten en omzet"
            eager
            sizes="(min-width: 1024px) 60vw, 100vw"
          >
            <BrowserFrame>
              <VisualDashboard />
            </BrowserFrame>
          </Screen>
        </div>
      </div>

      <div
        class="hero-zweef absolute -top-6 right-6 z-10 w-64 rounded-2xl border border-white/10 bg-ink/90 p-3.5 shadow-2xl shadow-black/40 backdrop-blur-xl max-sm:hidden lg:right-10"
        aria-hidden="true"
      >
        <div class="flex items-center gap-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-accent/15 text-accent">
            <svg
              class="size-[18px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="text-[13px] font-semibold text-white">Betaling ontvangen</p>
            <p class="truncate text-xs text-white/50">Liam Bakker &middot; &euro; 27,50</p>
          </div>
          <span class="ml-auto self-start text-[10px] text-white/35">nu</span>
        </div>
      </div>

      <div
        class="hero-kaart absolute -bottom-14 left-2 z-10 -rotate-6 [--kaart-u:0.42rem] max-sm:-bottom-10 max-sm:-left-1 max-sm:[--kaart-u:0.27rem] lg:-left-10 lg:[--kaart-u:0.5rem] xl:[--kaart-u:0.56rem]"
      >
        <CollectibleCard kaart={goud} />
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .hero-kantel {
      transform: rotateY(-13deg) rotateX(5deg);
      transform-origin: left center;
    }
  }
</style>
