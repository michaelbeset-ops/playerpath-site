const totaal = blokken.reduce((som, blok) => som + blok.punten.length, 0);
---

<section id="alles" class="bg-white py-12 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      eyebrow="Alles wat erin zit"
      title="Geen sterretjes, geen kleine lettertjes"
      intro={`${totaal} functies in zes onderdelen. Wat er niet in staat, beloven we ook niet.`}
      class="reveal"
    />

    <div
      class="reveal mt-12 grid gap-2 rounded-3xl border border-line bg-tint/70 p-2 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-3 lg:p-3"
      data-tabs
    >
      <div
        role="tablist"
        aria-label="Onderdelen"
        class="flex gap-1.5 overflow-x-auto [scrollbar-width:none] lg:flex-col lg:overflow-visible"
      >
        {
          blokken.map((blok, i) => (
            <button
              type="button"
              role="tab"
              id={`functies-tab-${i}`}
              aria-controls={`functies-paneel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="group flex shrink-0 items-center gap-3 rounded-2xl px-3 py-2.5 text-left transition-colors duration-200 hover:bg-white/70 aria-selected:bg-white aria-selected:shadow-[0_4px_16px_-8px_rgba(11,18,32,0.25)] lg:w-full"
            >
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-white text-accent-deep transition-colors duration-200 group-aria-selected:bg-ink group-aria-selected:text-accent">
                <svg
                  class="size-[18px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {blok.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <span class="min-w-0 pr-1">
                <span class="block whitespace-nowrap text-sm font-semibold text-ink">{blok.titel}</span>
                <span class="block whitespace-nowrap text-xs text-muted">{blok.punten.length} functies</span>
              </span>
            </button>
          ))
        }
      </div>

      {
        blokken.map((blok, i) => (
          <div
            role="tabpanel"
            id={`functies-paneel-${i}`}
            aria-labelledby={`functies-tab-${i}`}
            hidden={i !== 0}
            class="functies-paneel rounded-2xl bg-white p-6 shadow-[0_4px_20px_-12px_rgba(11,18,32,0.2)] sm:p-8 lg:p-10"
          >
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <h3 class="text-2xl font-semibold tracking-[-0.02em] text-ink">{blok.titel}</h3>
                <p class="mt-1.5 text-pretty text-[15px] text-muted">{blok.tekst}</p>
              </div>
              <span
                class={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${
                  blok.pakket === "In elk pakket" ? "bg-accent-soft text-accent-deep" : "bg-ink text-accent"
                }`}
              >
                {blok.pakket}
              </span>
            </div>

            <ul class="mt-8 grid gap-x-10 gap-y-3.5 border-t border-line pt-8 sm:grid-cols-2">
              {blok.punten.map((punt) => (
                <li class="flex items-start gap-3 text-[15px] leading-snug text-ink">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-deep">
                    <svg
                      class="size-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  {punt}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .functies-paneel:not([hidden]) {
      animation: paneel-in 0.35s ease-out;
    }
  }

  @keyframes paneel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Tabbladen met toetsenbord: pijltjes, Home en End, zoals een screenreader verwacht.
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((groep) => {
    const tabs = [...groep.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panelen = [...groep.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const kies = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const actief = i === index;
        tab.setAttribute("aria-selected", String(actief));
        tab.tabIndex = actief ? 0 : -1;
        panelen[i].hidden = !actief;
      });
      if (focus) tabs[index].focus();
      tabs[index].scrollIntoView({ block: "nearest", inline: "nearest" });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => kies(i));
      tab.addEventListener("keydown", (event) => {
        const laatste = tabs.length - 1;
        const doelen: Record<string, number> = {
          ArrowDown: i === laatste ? 0 : i + 1,
          ArrowRight: i === laatste ? 0 : i + 1,
          ArrowUp: i === 0 ? laatste : i - 1,
          ArrowLeft: i === 0 ? laatste : i - 1,
          Home: 0,
          End: laatste,
        };
        if (event.key in doelen) {
          event.preventDefault();
          kies(doelen[event.key], true);
        }
      });
    });
  });
</script>
