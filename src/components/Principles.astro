---
// Keuzes die PlayerPath bewust anders maakt. Vertellen wat je niet doet
// wekt meer vertrouwen dan nog een lijst functies: het laat zien dat er
// over nagedacht is.
const keuzes = [
  {
    niet: "Geen ranglijsten tussen spelers",
    wel: "Een kind van elf hoort niet op plek 14 van 20 te staan. Je ziet groei ten opzichte van zichzelf en van zijn eigen leeftijdsgroep, niet een klassement waarin iemand altijd onderaan bungelt.",
  },
  {
    niet: "Geen prijs per speler",
    wel: "Je betaalt één bedrag per maand. Groei je van veertig naar honderdveertig spelers, dan groeit je rekening niet mee. Bij software die per lid rekent, wordt succes duur.",
  },
  {
    niet: "Geen jaarcontract",
    wel: "Maandelijks opzegbaar, zonder opstartkosten. Als het niet werkt voor jouw school, moet je weg kunnen zonder gedoe. Dat houdt ons scherp.",
  },
  {
    niet: "Geen handel in jouw gegevens",
    wel: "Je werkt met gegevens van minderjarigen. Die blijven van jouw school, gaan niet naar derden, en je krijgt bij vertrek een export mee.",
  },
];
---

<section class="relative overflow-hidden bg-ink py-12 sm:py-28 lg:py-[7.5rem]">
  <div
    class="pointer-events-none absolute -left-32 bottom-0 size-[30rem] rounded-full bg-accent/8 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        Waar we voor staan
      </p>
      <h2
        class="mt-3 text-3xl font-semibold leading-[1.08] tracking-tight text-white sm:text-4xl lg:text-[2.75rem]"
      >
        Wat we bewust niet doen
      </h2>
      <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
        Elke keuze hieronder had ook anders gekund. We hebben er over nagedacht en
        het bewust zo gelaten.
      </p>
    </div>

    <div class="mt-8 grid gap-6 sm:mt-14 lg:mt-16 lg:grid-cols-2 swipe-rij max-sm:-mx-5 max-sm:flex max-sm:snap-x max-sm:snap-mandatory max-sm:gap-3 max-sm:overflow-x-auto max-sm:px-5 max-sm:pb-2 max-sm:[scrollbar-width:none]">
      {
        keuzes.map((keuze, i) => (
          <div
            class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-7 max-sm:w-[84%] max-sm:shrink-0 max-sm:snap-center"
            style={`transition-delay:${(i % 2) * 90}ms`}
          >
            <div class="flex items-start gap-3">
              <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg bg-white/[0.06] text-white/50">
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
              </span>
              <h3 class="text-xl font-semibold leading-snug tracking-tight text-white">
                {keuze.niet}
              </h3>
            </div>
            <p class="mt-4 pl-10 text-[15px] leading-relaxed text-white/65">{keuze.wel}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
