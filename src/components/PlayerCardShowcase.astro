---
import CollectibleCard from "./CollectibleCard.astro";
import Check from "./Check.astro";
import { kaarten } from "../data/spelers";

// Het onderscheid van PlayerPath, groot in beeld: vier kaarten als een hand
// die je vasthoudt. Bij hover waaieren ze iets verder uit.
//
// --x is de verschuiving in kaartbreedtes, --r de draaiing en --y een klein
// stukje omlaag voor de buitenste kaarten.
const waaier = {
  brons: { x: -0.75, y: 9, r: -13, z: 1 },
  zilver: { x: -0.25, y: 2, r: -4.5, z: 2 },
  goud: { x: 0.25, y: 2, r: 4.5, z: 4 },
  elite: { x: 0.75, y: 9, r: 13, z: 3 },
};

const levels = [
  { naam: "Brons", xp: "0 XP", verloop: "linear-gradient(135deg,#f2b98a,#b5651d 40%,#6b3a12 60%,#d98a4b)" },
  { naam: "Zilver", xp: "150 XP", verloop: "linear-gradient(135deg,#ffffff,#9aa6b3 40%,#4a535d 60%,#dfe6ec)" },
  { naam: "Goud", xp: "400 XP", verloop: "linear-gradient(135deg,#fbe28a,#c9961c 40%,#6e4a06 60%,#ecc95c)" },
  { naam: "Elite", xp: "900 XP", verloop: "linear-gradient(120deg,#8fd3ff,#c8a2ff 35%,#ffb3e6 60%,#a8ffd8)" },
];

const punten = [
  "Zes categorieën per positie, apart voor keepers en veldspelers",
  "Levels van brons tot elite, met XP voor elke training en elk rapport",
  "Per categorie een pijltje dat laat zien wat er beter of slechter ging",
  "Badges voor mijlpalen, zoals Vaste waarde en In de lift",
  "Deelbaar met opa en oma, met een grens aan wat een buitenstaander ziet",
  "Bewust geen ranglijst: een speler groeit ten opzichte van zichzelf",
];
---

<section id="spelerskaart" class="relative isolate overflow-hidden bg-ink py-20 sm:py-28 lg:py-32">
  <div
    class="absolute right-[-10rem] top-1/2 -z-10 h-[40rem] w-[40rem] -translate-y-1/2 rounded-full bg-[#a78bfa]/[0.10] blur-[140px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute left-[30%] top-0 -z-10 h-[28rem] w-[28rem] rounded-full bg-accent/[0.08] blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-16 px-5 sm:px-8 lg:grid-cols-[1fr_1.15fr] lg:gap-12">
    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        In Pro en Ultimate
      </p>
      <h2
        class="mt-3 text-balance text-3xl font-semibold leading-[1.05] tracking-[-0.03em] text-white sm:text-4xl lg:text-5xl"
      >
        Elke speler zijn eigen kaart
      </h2>
      <p class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-white/65 sm:text-lg">
        Na elk rapport groeit de kaart mee. Kinderen willen hem laten zien, ouders zien
        waarvoor ze betalen, en jij hebt een reden waarom spelers blijven.
      </p>

      <ul class="mt-8 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
        {
          levels.map((level) => (
            <li class="rounded-xl border border-white/10 bg-white/[0.03] p-3">
              <span class="block h-1.5 rounded-full" style={`background:${level.verloop}`} />
              <span class="mt-2.5 block text-sm font-semibold text-white">{level.naam}</span>
              <span class="block text-xs text-white/45">{level.xp}</span>
            </li>
          ))
        }
      </ul>

      <ul class="mt-8 space-y-3.5">
        {
          punten.map((punt) => (
            <li class="flex items-start gap-3 text-[15px] leading-relaxed text-white/80">
              <Check tone="light" />
              {punt}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="waaier group relative h-[17rem] [--kaart-u:0.4rem] sm:h-[26rem] sm:[--kaart-u:0.6rem] lg:h-[27rem] lg:[--kaart-u:0.62rem] xl:h-[30rem] xl:[--kaart-u:0.7rem]"
    >
      {
        kaarten.map((kaart) => {
          const plek = waaier[kaart.level];
          return (
            <div
              class="waaier-kaart absolute left-1/2 top-1/2"
              style={`--x:${plek.x};--y:${plek.y}%;--r:${plek.r}deg;z-index:${plek.z}`}
            >
              <CollectibleCard kaart={kaart} />
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .waaier-kaart {
    transform: translate(-50%, -50%) translateX(calc(var(--x) * 100%)) translateY(var(--y))
      rotate(var(--r));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .waaier:hover .waaier-kaart {
      transform: translate(-50%, -50%) translateX(calc(var(--x) * 118%))
        translateY(calc(var(--y) - 3%)) rotate(calc(var(--r) * 1.25));
    }
  }
</style>
