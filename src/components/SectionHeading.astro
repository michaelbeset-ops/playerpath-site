---
// Vaste kop voor elke sectie: klein label in hoofdletters, dikke titel, intro.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  align = "center",
  tone = "dark",
  class: extra = "",
} = Astro.props;

const uitlijning =
  align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-2xl text-left";

const titelKleur = tone === "dark" ? "text-ink" : "text-white";
const introKleur = tone === "dark" ? "text-muted" : "text-white/70";
const labelKleur = tone === "dark" ? "text-accent-deep" : "text-accent";
---

<div class={`${uitlijning} ${extra}`}>
  {
    eyebrow && (
      <p class={`text-xs font-semibold uppercase tracking-[0.18em] ${labelKleur}`}>
        {eyebrow}
      </p>
    )
  }
  <h2
    class={`mt-3 text-balance text-3xl font-semibold leading-[1.06] tracking-[-0.03em] sm:text-4xl lg:text-[2.75rem] ${titelKleur}`}
  >
    {title}
  </h2>
  {
    intro && (
      <p class={`mt-4 text-pretty text-base leading-relaxed sm:text-lg ${introKleur}`}>{intro}</p>
    )
  }
</div>
