---
import "@fontsource-variable/inter";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// De spelerskaart zoals het platform hem toont, overgenomen uit de embed van
// PlayerPath (app.playerpath.nl/embed/spelerskaart.html). Hier al bij het
// bouwen als HTML gerenderd in plaats van met JavaScript in de browser:
// sneller, en leesbaar voor Google.
//
// Alle maten hangen aan --u. Zet op een ouder `--kaart-u` en de hele kaart
// schaalt mee zonder te vervormen.
export interface Kaart {
  first_name: string;
  last_name: string;
  position: "keeper" | "field";
  age_category?: string;
  overall: number | null;
  level: "brons" | "zilver" | "goud" | "elite";
  xp: number;
  /** Percentage van de XP-balk. */
  progress: number;
  /** Weglaten betekent: geen rugnummer. */
  shirt_number?: number;
  season: string;
  school?: string;
  card_number?: string;
  /** [label, cijfer, verschil met vorig rapport] */
  categories: [string, number, number][];
  /** [icoon, label] */
  badges: [string, string][];
  foto?: ImageMetadata | null;
}

interface Props {
  kaart: Kaart;
  class?: string;
}

const { kaart: k, class: extra = "" } = Astro.props;

const ICONS: Record<string, string> = {
  trending: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  trophy:
    '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
  hand: '<path d="M18 11V6a2 2 0 0 0-4 0v1"/><path d="M14 10V4a2 2 0 0 0-4 0v2"/><path d="M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>',
  shirt:
    '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  user: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};

const LEVELS: Record<string, string> = { brons: "Brons", zilver: "Zilver", goud: "Goud", elite: "Elite", geen: "" };
const NEXT: Record<string, number> = { brons: 150, zilver: 400, goud: 900 };

const tier = k.overall == null ? "geen" : k.level;
const keeper = k.position === "keeper";
const volgende = NEXT[tier];
const xpTekst =
  k.overall == null
    ? "Je eerste rapport zet de kaart aan"
    : volgende
      ? `Nog ${Math.max(0, volgende - (k.xp || 0))} punten tot je volgende upgrade`
      : "Het hoogste level bereikt";
const icoon = (naam: string) => ICONS[naam] ?? ICONS.trophy;
---

<div class={`pp-kaart pp-wrap pp-tier-${tier} pp-${keeper ? "keeper" : "field"} ${extra}`}>
  <div class="pp-frame">
    <div class="pp-frame-glans" aria-hidden="true"></div>
    <div class="pp-frame-licht" aria-hidden="true"></div>

    <div class="pp-binnen">
      <div class="pp-foto-vak">
        {
          k.foto ? (
            <Image src={k.foto} alt="" widths={[360, 720]} sizes="360px" class="pp-foto" />
          ) : (
            <div class="pp-silhouet">
              <span class="pp-silhouet-icoon">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icoon("user")} />
              </span>
            </div>
          )
        }
        <div class="pp-foto-fade" aria-hidden="true"></div>
        <p class="pp-merk">PlayerPath</p>

        <div class="pp-overall-blok">
          <p class="pp-overall tabular">{k.overall ?? "—"}</p>
          <p class="pp-positie">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icoon(keeper ? "hand" : "shirt")} />
            {keeper ? "Keeper" : "Veldspeler"}
          </p>
          {k.age_category && <p class="pp-categorie">{k.age_category}</p>}
        </div>

        {k.shirt_number && <p class="pp-rugnummer tabular">{k.shirt_number}</p>}

        {
          k.badges.length > 0 && (
            <ul class="pp-badges" aria-label="Mijlpalen">
              {k.badges.slice(0, 3).map(([naam, label]) => (
                <li class="pp-badge">
                  <span class="pp-badge-icoon">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icoon(naam)} />
                  </span>
                  <span class="pp-badge-label">{label}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="pp-body">
        <div class="pp-patroon" aria-hidden="true"></div>

        <div class="pp-naam">
          <p class="pp-voornaam">{k.first_name}</p>
          <p class="pp-achternaam">{k.last_name}</p>
        </div>

        {
          k.overall == null ? (
            <p class="pp-leeg">Zodra het eerste rapport binnen is, komt deze kaart tot leven.</p>
          ) : (
            <div class="pp-stats">
              {k.categories.map(([label, cijfer, verschil]) => (
                <div class="pp-stat">
                  <div class="pp-stat-regel">
                    <span class="pp-stat-label">{label}</span>
                    {verschil !== 0 && (
                      <span class={`pp-delta tabular ${verschil > 0 ? "pp-delta-op" : "pp-delta-af"}`}>
                        {verschil > 0 ? `▲${verschil}` : `▼${Math.abs(verschil)}`}
                      </span>
                    )}
                    <span class="pp-stat-cijfer tabular">{cijfer}</span>
                  </div>
                  <div class="pp-balk">
                    <div class="pp-balk-vulling" style={`width:${cijfer}%`} />
                  </div>
                </div>
              ))}
            </div>
          )
        }

        <div class="pp-xp">
          <div class="pp-xp-regel">
            <span class="pp-xp-label">XP</span>
            <span class="pp-xp-cijfer tabular">{k.xp}</span>
          </div>
          <div class="pp-balk pp-balk-xp">
            <div class="pp-balk-vulling" style={`width:${k.progress}%`}></div>
          </div>
          <p class="pp-xp-tekst">{xpTekst}</p>
        </div>

        <div class="pp-voet">
          <p class="pp-voet-regel">
            Seizoen {k.season}{k.overall != null && LEVELS[tier] ? ` · Level ${LEVELS[tier]}` : ""}
          </p>
          {
            (k.school || k.card_number) && (
              <p class="pp-school">
                {k.school}
                {k.school && k.card_number ? " · " : ""}
                <span class="tabular">{k.card_number}</span>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Kantelen met de muis, met een lichtval die over het metaal meeloopt.
  // Alleen met een muis: op een telefoon zou de kaart bij scrollen wiebelen.
  const stil = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!stil) {
    document.querySelectorAll<HTMLElement>(".pp-wrap").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        el.style.setProperty("--pp-ry", `${((px - 0.5) * 14).toFixed(2)}deg`);
        el.style.setProperty("--pp-rx", `${(-(py - 0.5) * 12).toFixed(2)}deg`);
        el.style.setProperty("--pp-gx", `${(px * 100).toFixed(1)}%`);
        el.style.setProperty("--pp-gy", `${(py * 100).toFixed(1)}%`);
        el.style.setProperty("--pp-licht", "1");
      });
      el.addEventListener("pointerleave", () => {
        el.style.setProperty("--pp-rx", "0deg");
        el.style.setProperty("--pp-ry", "0deg");
        el.style.setProperty("--pp-licht", "0");
      });
    });
  }
</script>

<style is:global>

.pp-wrap, .pp-wrap *, .pp-wrap *::before, .pp-wrap *::after { box-sizing: border-box; }
.pp-wrap p, .pp-wrap ul { margin: 0; }
.pp-wrap ul { padding: 0; list-style: none; }
.pp-wrap svg { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.pp-wrap .tabular { font-variant-numeric: tabular-nums; }

/* ---------- Basis: de maten en de kleuren die elk level deelt ---------- */
.pp-wrap {
    --u: var(--kaart-u, 1rem);
    font-size: var(--u);
    font-family: 'Inter Variable', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --pp-facet: calc(var(--u) * 1);
    --pp-rand: calc(var(--u) * 0.4);
    --pp-surface-1: #131c30;
    --pp-surface-2: #0a0f1c;
    --pp-accent: #22e06b;
    --pp-tekst: #f1f5f9;
    --pp-tekst-zacht: #94a3b8;
    /* Per level overschreven: het metaal van het frame, de tint en de gloed. */
    --pp-tier: #94a3b8;
    --pp-tier-zacht: rgba(148, 163, 184, 0.18);
    --pp-gloed: rgba(148, 163, 184, 0.25);
    --pp-metaal: linear-gradient(135deg, #cfd6de 0%, #8c96a3 20%, #4b5563 38%, #d9dfe6 52%, #7b8592 68%, #3f4650 84%, #b5bdc7 100%);

    width: calc(var(--u) * 22.5);
    max-width: 100%;
    margin-inline: auto;
    color: var(--pp-tekst);
    font-variant-numeric: tabular-nums;
}

/*
 * Het frame: metaal met facet-hoeken. De hoeken komen van een clip-path, en
 * omdat die ook de schaduw wegknipt zit de gloed als drop-shadow op de wrap.
 */
.pp-frame {
    position: relative;
    padding: var(--pp-rand);
    background: var(--pp-metaal);
    clip-path: polygon(
        var(--pp-facet) 0,
        calc(100% - var(--pp-facet)) 0,
        100% var(--pp-facet),
        100% calc(100% - var(--pp-facet)),
        calc(100% - var(--pp-facet)) 100%,
        var(--pp-facet) 100%,
        0 calc(100% - var(--pp-facet)),
        0 var(--pp-facet)
    );
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 22px var(--pp-gloed));
    /* Kantelen (muis of gyroscoop) en omdraaien zitten in dezelfde transform. */
    transform: perspective(900px) rotateX(var(--pp-rx, 0deg)) rotateY(calc(var(--pp-ry, 0deg) + var(--pp-flip, 0deg)));
    transition: transform 0.28s ease;
    will-change: transform;
}

.pp-geen-overgang {
    transition: none;
}

/* De lichtval die met het kantelen meeloopt over het metaal. */
.pp-frame-licht {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--pp-licht, 0);
    background: radial-gradient(45% 45% at var(--pp-gx, 30%) var(--pp-gy, 20%), rgba(255, 255, 255, 0.45), transparent 70%);
    mix-blend-mode: soft-light;
    transition: opacity 0.4s ease;
}

/* Het rugnummer: groot en in het metaal van het level, linksonder op de foto
   (rechts staan de mijlpalen). */
.pp-rugnummer {
    position: absolute;
    left: calc(var(--u) * 0.9);
    bottom: calc(var(--u) * 0.35);
    z-index: 2;
    font-size: calc(var(--u) * 2.6);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--pp-tier);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
}

/* ---------- De achterkant ---------- */
.pp-achter-inhoud {
    position: relative;
    padding: calc(var(--u) * 1) calc(var(--u) * 1.1) calc(var(--u) * 0.9);
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 0.35);
}

.pp-achter-naam {
    font-size: calc(var(--u) * 1.05);
    font-weight: 800;
    letter-spacing: -0.01em;
}

.pp-achter-kop {
    margin-top: calc(var(--u) * 0.6);
    font-size: calc(var(--u) * 0.68);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pp-tier);
}

.pp-rapporten {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 0.35);
}

.pp-rapport {
    padding: calc(var(--u) * 0.5) calc(var(--u) * 0.65);
    border-radius: calc(var(--u) * 0.6);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
}

.pp-rapport-regel {
    display: flex;
    align-items: baseline;
    gap: calc(var(--u) * 0.5);
    font-size: calc(var(--u) * 0.8);
}

.pp-rapport-trainer {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--pp-tekst-zacht);
}

.pp-rapport-cijfer {
    margin-left: auto;
    font-size: calc(var(--u) * 1.05);
    font-weight: 800;
}

.pp-rapport-noot {
    margin-top: calc(var(--u) * 0.2);
    font-size: calc(var(--u) * 0.75);
    line-height: 1.35;
    color: var(--pp-tekst-zacht);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.pp-achter-leeg {
    font-size: calc(var(--u) * 0.78);
    color: var(--pp-tekst-zacht);
}

.pp-doel {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 0.35);
    padding: calc(var(--u) * 0.5) calc(var(--u) * 0.65);
    border-radius: calc(var(--u) * 0.6);
    background: rgba(34, 224, 107, 0.08);
    box-shadow: inset 0 0 0 1px rgba(34, 224, 107, 0.25);
}

.pp-doel-status {
    margin-left: auto;
    font-size: calc(var(--u) * 0.7);
    font-weight: 700;
    color: var(--pp-accent);
}

.pp-achter-badges {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 0.35);
}

.pp-achter-voet {
    margin-top: auto;
    padding-top: calc(var(--u) * 0.8);
}

/* ---------- Het pijltje per categorie ---------- */
.pp-delta {
    margin-left: auto;
    font-size: calc(var(--u) * 0.68);
    font-weight: 800;
    padding: calc(var(--u) * 0.05) calc(var(--u) * 0.3);
    border-radius: 999px;
    animation: pp-delta-in 0.6s ease-out both;
}

.pp-delta-op {
    color: #22e06b;
    background: rgba(34, 224, 107, 0.14);
}

.pp-delta-af {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.14);
}

@keyframes pp-delta-in {
    from {
        opacity: 0;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: none;
    }
}

/* De glans over het metaal: een lichtval linksboven en een diagonale streep. */
.pp-frame-glans {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
        linear-gradient(115deg, transparent 32%, rgba(255, 255, 255, 0.55) 44%, rgba(255, 255, 255, 0.1) 50%, transparent 58%),
        radial-gradient(70% 40% at 10% 0%, rgba(255, 255, 255, 0.5), transparent 70%);
    mix-blend-mode: soft-light;
}

.pp-binnen {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--pp-surface-1), var(--pp-surface-2));
    clip-path: polygon(
        calc(var(--pp-facet) - var(--pp-rand)) 0,
        calc(100% - var(--pp-facet) + var(--pp-rand)) 0,
        100% calc(var(--pp-facet) - var(--pp-rand)),
        100% calc(100% - var(--pp-facet) + var(--pp-rand)),
        calc(100% - var(--pp-facet) + var(--pp-rand)) 100%,
        calc(var(--pp-facet) - var(--pp-rand)) 100%,
        0 calc(100% - var(--pp-facet) + var(--pp-rand)),
        0 calc(var(--pp-facet) - var(--pp-rand))
    );
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
}

/* ---------- De foto ---------- */
.pp-foto-vak {
    position: relative;
    aspect-ratio: 3 / 2;
    background: radial-gradient(80% 60% at 50% 30%, var(--pp-tier-zacht), transparent 70%), var(--pp-surface-1);
}

.pp-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
}

/* Zonder foto: een net silhouet, en voor wie het mag een knop. */
.pp-silhouet {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: calc(var(--u) * 0.5);
    height: 100%;
    padding-bottom: calc(var(--u) * 2.75);
}

.pp-silhouet-icoon {
    width: calc(var(--u) * 5.5);
    height: calc(var(--u) * 5.5);
    color: var(--pp-tier);
    opacity: 0.35;
}

.pp-foto-knop {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--u) * 0.35);
    padding: calc(var(--u) * 0.4) calc(var(--u) * 0.8);
    border-radius: 999px;
    font-size: calc(var(--u) * 0.75);
    font-weight: 600;
    color: var(--pp-tekst);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
}

.pp-foto-knop:hover {
    background: rgba(255, 255, 255, 0.18);
}

/* Boven donkerder voor het cijfer, onder een fade naar het vlak eronder. */
.pp-foto-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(5, 8, 16, 0.55) 0%, transparent 40%), linear-gradient(180deg, transparent 50%, var(--pp-surface-1) 100%);
}

.pp-merk {
    position: absolute;
    top: calc(var(--u) * 0.55);
    left: 0;
    right: 0;
    text-align: center;
    font-size: calc(var(--u) * 0.5625);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--pp-tier);
    opacity: 0.9;
}

.pp-overall-blok {
    position: absolute;
    top: calc(var(--u) * 1.5);
    left: calc(var(--u) * 1);
    line-height: 1;
}

.pp-overall {
    font-size: calc(var(--u) * 3.75);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--pp-accent);
    text-shadow:
        0 2px 12px rgba(0, 0, 0, 0.6),
        0 0 28px rgba(34, 224, 107, 0.35);
}

.pp-positie {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--u) * 0.3);
    margin-top: calc(var(--u) * 0.4);
    font-size: calc(var(--u) * 0.6875);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pp-tier);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
}

.pp-categorie {
    margin-top: calc(var(--u) * 0.3);
    font-size: calc(var(--u) * 0.6875);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--pp-tekst);
    opacity: 0.85;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
}

/* Drie badges rechtsboven: rond icoon in de tint van het level, label eronder. */
.pp-badges {
    position: absolute;
    top: calc(var(--u) * 1.5);
    right: calc(var(--u) * 0.85);
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 0.5);
    margin: 0;
    padding: 0;
    list-style: none;
}

.pp-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--u) * 0.2);
    width: calc(var(--u) * 3.75);
}

.pp-badge-icoon {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 1.9);
    height: calc(var(--u) * 1.9);
    border-radius: 999px;
    color: var(--pp-surface-2);
    background: var(--pp-metaal);
    box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.35) inset,
        0 4px 10px rgba(0, 0, 0, 0.5);
}

.pp-badge-label {
    max-width: 100%;
    line-height: 1.15;
    font-size: calc(var(--u) * 0.5625);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--pp-tekst);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
}

/* ---------- Het onderste deel ---------- */
.pp-body {
    position: relative;
    padding: 0 calc(var(--u) * 1) calc(var(--u) * 0.9);
}

/* Keepers: diagonale handschoen-strepen. Veldspelers: veldlijnen. Subtiel. */
.pp-patroon {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
}

.pp-keeper .pp-patroon {
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0 2px, transparent 2px 18px);
}

.pp-field .pp-patroon {
    background:
