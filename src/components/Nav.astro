---
// De menubalk: een volle balk boven de pagina, logo links en de vijf
// belangrijkste pagina's er direct naast. De pagina waar je bent krijgt een
// groen streepje. Dat gebeurt bij het bouwen, dus zonder JavaScript.
const links = [
  { label: "Voetbalscholen", href: "/software-voetbalschool/" },
  { label: "Keeperscholen", href: "/software-keeperschool/" },
  { label: "Spelervolgsysteem", href: "/spelervolgsysteem/" },
  { label: "Inschrijven", href: "/inschrijven-en-incasso/" },
  { label: "Tarieven", href: "/tarieven/" },
];

const basis = import.meta.env.BASE_URL.replace(/\/$/, "");
const huidig = Astro.url.pathname.replace(/\/$/, "");
const actief = (href: string) => huidig === href.replace(/\/$/, "");
---

<header
  id="kop"
  class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 backdrop-blur-xl transition-shadow duration-300"
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-5 sm:px-8" aria-label="Hoofdmenu">
    <a href={`${basis}/`} class="flex shrink-0 items-center">
      <img
        src={`${basis}/logo/playerpath-logo-wit.png`}
        alt="PlayerPath"
        width="898"
        height="192"
        class="h-7 w-auto sm:h-8"
      />
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={`${basis}${link.href}`}
              aria-current={actief(link.href) ? "true" : "false"}
              class={`relative flex h-16 items-center text-[14px] font-medium transition-colors duration-200 hover:text-white ${
                actief(link.href) ? "text-white" : "text-white/60"
              }`}
            >
              {link.label}
              {actief(link.href) && (
                <span class="absolute inset-x-0 bottom-0 h-0.5 rounded-full bg-accent" />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-5">
      <a
        href="https://app.playerpath.nl"
        class="hidden text-[14px] font-medium text-white/65 transition-colors duration-200 hover:text-white sm:block"
      >
        Inloggen
      </a>
      <a
        href={`${basis}/#proef-aanvragen`}
        class="hidden items-center rounded-lg bg-accent px-4 py-2 text-[14px] font-semibold text-ink shadow-[inset_0_0_0_1px_rgba(255,255,255,0.15)] transition-colors duration-200 hover:bg-[#4ade80] sm:inline-flex"
      >
        Plan een demo
      </a>

      <button
        id="menuknop"
        type="button"
        class="-mr-2 grid size-10 place-items-center rounded-lg text-white transition-colors duration-200 hover:bg-white/[0.06] lg:hidden"
        aria-expanded="false"
        aria-controls="mobielmenu"
      >
        <span class="sr-only">Menu openen</span>
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobielmenu" hidden class="border-t border-white/10 bg-ink lg:hidden">
    <div class="mx-auto max-w-7xl px-3 pb-4 pt-2 sm:px-6">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={`${basis}${link.href}`}
                class={`block rounded-lg px-3 py-3 text-[15px] font-medium transition-colors hover:bg-white/[0.05] ${
                  actief(link.href) ? "bg-white/[0.06] text-white" : "text-white/75"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-3 grid grid-cols-2 gap-2 px-1">
        <a
          href="https://app.playerpath.nl"
          class="rounded-lg border border-white/10 px-4 py-3 text-center text-sm font-semibold text-white"
        >
          Inloggen
        </a>
        <a
          href={`${basis}/#proef-aanvragen`}
          class="rounded-lg bg-accent px-4 py-3 text-center text-sm font-semibold text-ink"
        >
          Plan een demo
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const kop = document.getElementById("kop");
  const knop = document.getElementById("menuknop");
  const paneel = document.getElementById("mobielmenu");

  // Zodra je scrollt krijgt de balk een schaduw, zodat hij loskomt van de
  // lichte secties die eronder doorlopen.
  if (kop) {
    const bijwerken = () => {
      const gescrold = window.scrollY > 8;
      kop.classList.toggle("shadow-lg", gescrold);
      kop.classList.toggle("shadow-ink/40", gescrold);
    };
    bijwerken();
    window.addEventListener("scroll", bijwerken, { passive: true });
  }

  if (knop && paneel) {
    knop.addEventListener("click", () => {
      const openen = paneel.hidden;
      paneel.hidden = !openen;
      knop.setAttribute("aria-expanded", String(openen));
    });
    paneel.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        paneel.hidden = true;
        knop.setAttribute("aria-expanded", "false");
      }),
    );
  }
</script>
