---
import Button from "./Button.astro";
import PitchLines from "./PitchLines.astro";

// De kop van een landingspagina: kruimelpad, één duidelijke H1, en meteen
// een reden om door te lezen. Het kruimelpad staat er ook als gestructureerde
// data in, zodat Google het pad in de zoekresultaten kan tonen.
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  punten?: string[];
  kruimel: string;
}

const { eyebrow, title, intro, punten = [], kruimel } = Astro.props;

const basis = import.meta.env.BASE_URL.replace(/\/$/, "");
const thuis = (Astro.site ?? new URL("https://playerpath.nl")).href.replace(/\/$/, "");
const canoniek = new URL(Astro.url.pathname, `${thuis}/`).href;

const kruimelSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "PlayerPath", item: `${thuis}/` },
    { "@type": "ListItem", position: 2, name: kruimel, item: canoniek },
  ],
};
---

<section class="relative isolate overflow-hidden bg-ink pt-16 pb-16 sm:pt-20 sm:pb-20">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <PitchLines
      class="text-white/[0.06] [mask-image:radial-gradient(ellipse_60%_70%_at_50%_35%,black,transparent_78%)]"
    />
    <div
      class="absolute left-1/2 top-[-20rem] h-[38rem] w-[54rem] -translate-x-1/2 bg-[radial-gradient(closest-side,rgb(34_197_94/0.15),transparent)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-5 sm:px-8">
    <nav aria-label="Kruimelpad" class="text-[13px] text-white/45">
      <a href={`${basis}/`} class="transition-colors hover:text-white">PlayerPath</a>
      <span class="mx-2 text-white/25">/</span>
      <span class="text-white/70">{kruimel}</span>
    </nav>

    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
    <h1
      class="mt-3 text-balance text-[2.4rem] font-semibold leading-[1.05] tracking-[-0.035em] text-white sm:text-5xl lg:text-[3.4rem]"
    >
      {title}
    </h1>
    <p class="mt-5 max-w-2xl text-pretty text-lg leading-relaxed text-white/65">{intro}</p>

    {
      punten.length > 0 && (
        <ul class="mt-8 grid gap-2.5 sm:grid-cols-2">
          {punten.map((punt) => (
            <li class="flex items-start gap-3 text-[15px] leading-snug text-white/80">
              <svg
                class="mt-1 size-4 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {punt}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7">
      <Button href={`${basis}/#proef-aanvragen`} size="lg">Plan een demo</Button>
      <a
        href={`${basis}/tarieven/`}
        class="group inline-flex items-center gap-2 text-[15px] font-semibold text-white/75 transition-colors hover:text-white"
      >
        Bekijk de tarieven
        <svg
          class="btn-arrow size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(kruimelSchema)} is:inline />
