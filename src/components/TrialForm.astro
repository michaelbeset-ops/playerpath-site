---
import Check from "./Check.astro";

// Waar de aanvragen heen gaan. Verander alleen dit adres en de rest volgt.
//
// We versturen via FormSubmit: die dienst vraagt geen account, maar stuurt
// bij de allereerste aanvraag een bevestigingsmail naar dit adres. Klik die
// link één keer, daarna komt elke aanvraag gewoon binnen.
const ontvanger = "michael.beset@gmail.com";
const endpoint = `https://formsubmit.co/${ontvanger}`;

// Na het versturen gaat de bezoeker naar onze eigen bedankpagina.
const basis = import.meta.env.BASE_URL.replace(/\/$/, "");
const bedankt = new URL(`${basis}/bedankt/`, Astro.site ?? "http://localhost:4321").href;

// LET OP: oude opmerking.
// Zet in `action` het echte endpoint (bijvoorbeeld Formspree, of je eigen route)
// voordat de site live gaat, anders komt er niets binnen.
const punten = [
  "Een demo met jouw eigen groepen en tarieven",
  "Geen opstartkosten, maandelijks opzegbaar",
  "Hulp bij het overzetten van je administratie",
];
---

<section id="proef-aanvragen" class="bg-white pb-20 sm:pb-28 lg:pb-[7.5rem]">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal overflow-hidden rounded-3xl bg-ink">
      <div class="grid gap-12 p-8 sm:p-12 lg:grid-cols-2 lg:gap-16 lg:p-16">
        <div class="relative">
          <div
            class="pointer-events-none absolute -left-20 -top-20 size-72 bg-[radial-gradient(closest-side,rgb(34_197_94/0.16),transparent)]"
            aria-hidden="true"
          >
          </div>

          <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
              Aan de slag
            </p>
            <h2
              class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight text-white sm:text-4xl"
            >
              Zie PlayerPath met jouw school erin
            </h2>
            <p class="mt-4 max-w-md leading-relaxed text-white/70">
              Laat je gegevens achter. We plannen een demo waarin je ziet hoe jouw
              groepen, tarieven en spelers er straks uitzien.
            </p>

            <ul class="mt-8 space-y-3.5">
              {
                punten.map((punt) => (
                  <li class="flex items-start gap-3 text-[15px] font-medium text-white/85">
                    <Check tone="light" />
                    {punt}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <form
          class="rounded-2xl bg-white p-6 shadow-2xl shadow-black/25 sm:p-8"
          action={endpoint}
          method="POST"
        >
          <!-- Instellingen voor FormSubmit; de bezoeker ziet hier niets van. -->
          <input type="hidden" name="_subject" value="Nieuwe demo-aanvraag via playerpath.nl" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={bedankt} />

          <!-- Spamval: een mens laat dit veld leeg, een bot vult het in. -->
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="naam" class="block text-sm font-semibold text-ink">
                Naam
              </label>
              <input
                id="naam"
                name="naam"
                type="text"
                required
                autocomplete="name"
                class="mt-1.5 w-full rounded-[10px] border border-line bg-white px-3.5 py-2.5 text-[15px] text-ink placeholder:text-muted/60 focus:border-accent-deep focus:outline-none"
                placeholder="Youri de Boer"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="school" class="block text-sm font-semibold text-ink">
                Naam van je school
              </label>
              <input
                id="school"
                name="school"
                type="text"
                required
                autocomplete="organization"
                class="mt-1.5 w-full rounded-[10px] border border-line bg-white px-3.5 py-2.5 text-[15px] text-ink placeholder:text-muted/60 focus:border-accent-deep focus:outline-none"
                placeholder="Keepersclinic Noord"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-ink">
                E-mailadres
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-1.5 w-full rounded-[10px] border border-line bg-white px-3.5 py-2.5 text-[15px] text-ink placeholder:text-muted/60 focus:border-accent-deep focus:outline-none"
                placeholder="jij@school.nl"
              />
            </div>

            <div>
              <label for="spelers" class="block text-sm font-semibold text-ink">
                Aantal spelers
              </label>
              <select
                id="spelers"
                name="spelers"
                class="mt-1.5 w-full rounded-[10px] border border-line bg-white px-3.5 py-2.5 text-[15px] text-ink focus:border-accent-deep focus:outline-none"
              >
                <option>Minder dan 50</option>
                <option>50 tot 150</option>
                <option>150 tot 300</option>
                <option>Meer dan 300</option>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label for="bericht" class="block text-sm font-semibold text-ink">
                Waar loop je nu tegenaan? <span class="font-normal text-muted">(optioneel)</span>
              </label>
              <textarea
                id="bericht"
                name="bericht"
                rows="3"
                class="mt-1.5 w-full rounded-[10px] border border-line bg-white px-3.5 py-2.5 text-[15px] text-ink placeholder:text-muted/60 focus:border-accent-deep focus:outline-none"
                placeholder="Bijvoorbeeld: de inschrijvingen lopen nu via de mail."
              ></textarea>
            </div>
          </div>

          <button
            type="submit"
            class="group mt-6 flex w-full items-center justify-between rounded-[10px] bg-accent py-[5px] pl-5 pr-[5px] text-[15px] font-semibold leading-none text-ink transition-colors duration-200 hover:bg-accent-deep hover:text-white"
          >
            Demo aanvragen
            <span class="grid size-8 place-items-center rounded-lg bg-ink text-accent" aria-hidden="true">
              <svg
                class="btn-arrow size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </button>

          <p class="mt-4 text-xs leading-relaxed text-muted">
            We gebruiken je gegevens alleen om contact met je op te nemen over PlayerPath.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
