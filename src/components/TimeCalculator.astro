---
// De tijdwinst-calculator.
//
// Staat bewust vlak vóór de tarieven: eerst zie je wat PlayerPath doet, dan
// reken je uit wat het oplevert, en pas daarna zie je wat het kost.
//
// Transparant: elke aanname is uitklapbaar. Een ondernemer rekent zelf na.
// LET OP: toets de minuten in `taken` bij twee of drie echte scholen.
const taken = [
  { naam: "Terugkoppeling naar ouders", nu: 15, straks: 1, eenheid: "speler-kwartaal", optioneel: true },
  { naam: "Betaling klaarzetten en afvinken", nu: 3.5, straks: 0.2, eenheid: "speler-maand" },
  { naam: "Aanwezigheid bijhouden", nu: 6, straks: 1.5, eenheid: "training" },
  { naam: "Vragen van ouders beantwoorden", nu: 1.5, straks: 0.5, eenheid: "speler-maand" },
  { naam: "Achterstallige betaling najagen", nu: 9, straks: 1, eenheid: "wanbetaler-maand" },
  { naam: "Inschrijving verwerken", nu: 8, straks: 1, eenheid: "nieuwe-speler" },
];

const schuifjes = [
  { id: "tw-spelers", label: "Actieve spelers", min: 10, max: 400, step: 5, waarde: 60, euro: false },
  { id: "tw-trainingen", label: "Trainingen per week", min: 1, max: 30, step: 1, waarde: 6, euro: false },
  { id: "tw-nieuw", label: "Nieuwe spelers per seizoen", min: 0, max: 200, step: 5, waarde: 20, euro: false },
  { id: "tw-uurtarief", label: "Wat is jouw uur waard?", min: 15, max: 120, step: 5, waarde: 40, euro: true },
];
---

<section id="tijdwinst" class="relative isolate overflow-hidden bg-ink py-16 sm:py-24">
  <div class="absolute -right-40 top-10 -z-10 size-[34rem] rounded-full bg-accent/10 blur-[130px]" aria-hidden="true"></div>

  <div
    class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start lg:gap-12"
  >
    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Reken het na</p>
      <h2 class="mt-3 text-balance text-3xl font-semibold leading-[1.06] tracking-[-0.03em] text-white sm:text-4xl lg:text-[2.6rem]">
        Wat kost je administratie nu?
      </h2>
      <p class="mt-4 max-w-md text-pretty leading-relaxed text-white/60">
        Los gereedschap voelt gratis. Dat is het niet, je betaalt in avonden. Zet je eigen
        cijfers erin.
      </p>

      <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
        <div class="space-y-5">
          {
            schuifjes.map((s) => (
              <div>
                <div class="flex items-baseline justify-between">
                  <label for={s.id} class="text-sm font-medium text-white/85">
                    {s.label}
                  </label>
                  <output id={`${s.id}-uit`} class="text-sm font-semibold tabular-nums text-accent">
                    {s.euro ? `€ ${s.waarde}` : s.waarde}
                  </output>
                </div>
                <input
                  id={s.id}
                  type="range"
                  min={s.min}
                  max={s.max}
                  step={s.step}
                  value={s.waarde}
                  class="tw-range mt-2.5"
                />
              </div>
            ))
          }

          <label class="flex cursor-pointer items-start gap-3 border-t border-white/10 pt-5">
            <input id="tw-verslag" type="checkbox" checked class="mt-0.5 size-4 shrink-0 accent-[#22c55e]" />
            <span class="text-sm leading-relaxed text-white/70">
              Ik koppel nu ook terug aan ouders over de ontwikkeling van hun kind
            </span>
          </label>
        </div>
      </div>
    </div>

    <div
      class="reveal rounded-3xl border border-accent/20 bg-gradient-to-b from-white/[0.07] to-white/[0.02] p-6 shadow-[0_40px_100px_-40px_rgba(34,197,94,0.25)] sm:p-7"
      style="transition-delay:100ms"
    >
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <p class="text-sm text-white/55">Je bent nu kwijt</p>
          <p class="mt-1 flex items-baseline gap-2">
            <span id="tw-uren" class="text-6xl font-semibold tabular-nums tracking-[-0.04em] text-accent">12</span>
            <span class="text-base text-white/65">uur per maand</span>
          </p>
        </div>
        <div class="sm:text-right">
          <p class="text-sm text-white/55">Op jaarbasis</p>
          <p id="tw-euro" class="mt-1 text-3xl font-semibold tabular-nums tracking-tight text-white">&euro; 5.722</p>
        </div>
      </div>
      <p id="tw-zin" class="mt-3 text-sm text-white/55">
        Dat is elke maand ruim een hele werkdag aan overtypen, najagen en afvinken.
      </p>

      <div class="mt-6 border-t border-white/10 pt-5">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">
          Waar het in zit, per maand
        </p>
        <ul id="tw-lijst" class="mt-4 space-y-3"></ul>
      </div>

      <div class="mt-6 flex items-center justify-between rounded-xl bg-accent/10 px-4 py-3">
        <p class="text-sm font-medium text-white">Blijft over met PlayerPath</p>
        <p id="tw-rest" class="text-sm font-semibold tabular-nums text-accent">1 u 47 m</p>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 text-sm text-white/55 transition-colors hover:text-white">
            Zo rekenen we
            <svg class="size-4 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="mt-3 space-y-2 text-[13px] leading-relaxed text-white/50">
            <ul class="space-y-1">
              {
                taken.map((taak) => (
                  <li class="flex justify-between gap-6">
                    <span>{taak.naam}</span>
                    <span class="shrink-0 tabular-nums text-white/35">
                      {String(taak.nu).replace(".", ",")} naar {String(taak.straks).replace(".", ",")} min
                    </span>
                  </li>
                ))
              }
            </ul>
            <p>
              Met 12% betalers die je per maand moet najagen en vier weken per maand. Het zijn
              schattingen, geen garanties.
            </p>
          </div>
        </details>
        <a href="#proef-aanvragen" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-white">
          Samen narekenen in een demo
          <svg class="btn-arrow size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .tw-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 0.3rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    outline-offset: 6px;
  }
  .tw-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--color-accent);
    border: 3px solid var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-accent);
    cursor: pointer;
  }
  .tw-range::-moz-range-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--color-accent);
    border: 3px solid var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-accent);
    cursor: pointer;
  }
</style>

<script is:inline define:vars={{ taken }}>
  (() => {
    const el = (id) => document.getElementById(id);
    const spelers = el("tw-spelers");
    const trainingen = el("tw-trainingen");
    const nieuw = el("tw-nieuw");
    const uurtarief = el("tw-uurtarief");
    const verslag = el("tw-verslag");
    if (!spelers) return;

    const nl = new Intl.NumberFormat("nl-NL");
    const euro = new Intl.NumberFormat("nl-NL", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });

    // Minuten als "3 u 20 m", want niemand denkt in 3,33 uur.
    const alsTijd = (minuten) => {
      const totaal = Math.round(minuten);
      const uren = Math.floor(totaal / 60);
      const rest = totaal % 60;
      if (uren === 0) return rest + " m";
      if (rest === 0) return uren + " u";
      return uren + " u " + rest + " m";
    };

    const aantalPerMaand = (eenheid, w) => {
      switch (eenheid) {
        case "nieuwe-speler": return w.nieuw / 12;
        case "speler-maand": return w.spelers;
        case "wanbetaler-maand": return w.spelers * 0.12;
        case "training": return w.trainingen * 4;
        case "speler-kwartaal": return w.spelers / 3;
        default: return 0;
      }
    };

    const bereken = () => {
      const w = {
        spelers: Number(spelers.value),
        trainingen: Number(trainingen.value),
        nieuw: Number(nieuw.value),
        tarief: Number(uurtarief.value),
      };

      el("tw-spelers-uit").textContent = nl.format(w.spelers);
      el("tw-trainingen-uit").textContent = nl.format(w.trainingen);
      el("tw-nieuw-uit").textContent = nl.format(w.nieuw);
      el("tw-uurtarief-uit").textContent = euro.format(w.tarief);

      let nuTotaal = 0;
      let straksTotaal = 0;
      const regels = [];

      taken.forEach((taak) => {
        if (taak.optioneel && !verslag.checked) return;
        const aantal = aantalPerMaand(taak.eenheid, w);
        const nuMin = aantal * taak.nu;
        const straksMin = aantal * taak.straks;
        if (nuMin < 0.5) return;
        nuTotaal += nuMin;
        straksTotaal += straksMin;
        regels.push({ naam: taak.naam, minuten: nuMin - straksMin });
      });

      const winstUur = (nuTotaal - straksTotaal) / 60;
      el("tw-uren").textContent = nl.format(Math.round(winstUur));
      el("tw-euro").textContent = euro.format(Math.round(winstUur * 12 * w.tarief));
      el("tw-rest").textContent = alsTijd(straksTotaal);

      const dagen = winstUur / 8;
      el("tw-zin").textContent =
        dagen >= 2
          ? "Dat zijn ruim " + nl.format(Math.round(dagen)) + " werkdagen per maand aan overtypen, najagen en afvinken."
          : dagen >= 1
            ? "Dat is elke maand ruim een hele werkdag aan overtypen, najagen en afvinken."
            : "Dat is elke maand een halve werkdag aan overtypen, najagen en afvinken.";

      regels.sort((a, b) => b.minuten - a.minuten);
      const grootste = regels.length ? regels[0].minuten : 1;
      el("tw-lijst").innerHTML = regels
        .map(
          (r) =>
            "<li>" +
            '<div class="flex items-baseline justify-between gap-4 text-sm">' +
            '<span class="text-white/75">' + r.naam + "</span>" +
            '<span class="font-semibold tabular-nums text-white">' + alsTijd(r.minuten) + "</span>" +
            "</div>" +
            '<div class="mt-1.5 h-1 overflow-hidden rounded-full bg-white/[0.07]">' +
            '<div class="h-full rounded-full bg-gradient-to-r from-accent/50 to-accent" style="width:' +
            Math.max(4, Math.round((r.minuten / grootste) * 100)) +
            '%"></div>' +
            "</div>" +
            "</li>",
        )
        .join("");
    };

    [spelers, trainingen, nieuw, uurtarief].forEach((input) => input.addEventListener("input", bereken));
    verslag.addEventListener("change", bereken);
    bereken();
  })();
</script>
