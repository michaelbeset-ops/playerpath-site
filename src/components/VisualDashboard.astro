---
import AppChrome from "./AppChrome.astro";

// Nagebouwd naar /dashboard van PlayerPath, met de voorbeeldschool
// "Keepersschool Rob". Verdwijnt vanzelf zodra src/assets/screens/dashboard.png
// bestaat.
const stats = [
  { label: "Actieve spelers", waarde: "9", trend: "+9", meta: "9 erbij deze maand" },
  { label: "Gemiddelde rating", waarde: "77", trend: null, meta: "alle spelers" },
  { label: "Rapporten deze week", waarde: "17", trend: "+6", meta: "vorige week 11" },
  { label: "Omzet deze maand", waarde: "€ 82,50", trend: "0%", meta: "tot dezelfde dag vorige maand" },
];

const stijgers = [
  { naam: "Youssef El Amrani", groei: "+7" },
  { naam: "Noor Visser", groei: "+6" },
  { naam: "Sam de Boer", groei: "+4" },
];

const trainingen = [
  { tijd: "18:00", dag: "Vandaag", naam: "Keepers middag", plek: "Sportpark De Vliert" },
  { tijd: "18:00", dag: "Do 10 sep", naam: "Voorbeeldgroep", plek: "De Voorbeeldweide" },
  { tijd: "10:00", dag: "Za 12 sep", naam: "Keepers ochtend", plek: "De Vliert, veld 3" },
];
---

<div class="aspect-[16/10] overflow-hidden bg-[#f6f8fa] text-left" aria-hidden="true">
  <AppChrome actief="Dashboard" />

  <div class="px-4 py-4 sm:px-7 sm:py-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-base font-semibold tracking-tight text-ink sm:text-xl">Dashboard</p>
        <p class="text-[10px] text-muted sm:text-xs">Keepersschool Rob &middot; eigenaar</p>
      </div>
      <div class="hidden gap-2 sm:flex">
        <span class="rounded-lg bg-[#12813d] px-3 py-2 text-[11px] font-semibold text-white">
          Rapport invullen
        </span>
        <span
          class="rounded-lg border border-line bg-white px-3 py-2 text-[11px] font-semibold text-ink"
        >
          Training inplannen
        </span>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-2.5 sm:mt-5 sm:gap-3 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="rounded-xl border border-line bg-white p-3 shadow-sm sm:p-4">
            <p class="truncate text-[10px] text-muted sm:text-xs">{s.label}</p>
            <p class="mt-1.5 text-lg font-semibold tracking-tight text-ink sm:text-2xl">{s.waarde}</p>
            <p class="mt-1 truncate text-[9px] text-muted sm:text-[11px]">
              {s.trend && <span class="mr-1 font-semibold text-[#12813d]">{s.trend}</span>}
              {s.meta}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-3 hidden gap-3 sm:grid lg:grid-cols-3">
      <div class="rounded-xl border border-line bg-white p-4 shadow-sm lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <p class="text-sm font-semibold text-ink">Ontwikkeling</p>
          <p class="text-[11px] font-semibold text-[#12813d] underline underline-offset-2">
            Alle rapporten
          </p>
        </div>
        <div class="mt-3 flex items-baseline justify-between text-xs">
          <span class="text-muted">Spelers met een actueel rapport</span>
          <span class="font-semibold text-ink">100%</span>
        </div>
        <div class="mt-1.5 h-2 rounded-full bg-[#12813d]"></div>
        <p class="mt-1 text-[10px] text-muted">9 van 9, in de laatste 30 dagen</p>

        <p class="mt-4 text-[10px] font-semibold uppercase tracking-wider text-muted">
          Grootste stijgers
        </p>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          {
            stijgers.map((s) => (
              <div class="flex items-center justify-between rounded-lg border border-line px-3 py-2">
                <span class="truncate text-xs text-ink">{s.naam}</span>
                <span class="ml-2 text-xs font-semibold text-[#12813d]">{s.groei}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="hidden flex-col gap-3 lg:flex">
        <div class="rounded-xl border border-line bg-white p-4 shadow-sm">
          <p class="text-sm font-semibold text-ink">Financieel</p>
          <p class="mt-2 text-xl font-semibold tracking-tight text-[#b45309]">&euro; 422,50</p>
          <p class="text-[10px] text-muted">openstaand &middot; 5 rekeningen</p>
          <p class="mt-2 text-sm font-semibold text-ink">4</p>
          <p class="text-[10px] text-muted">lopende abonnementen</p>
        </div>
        <div class="rounded-xl border border-line bg-white p-4 shadow-sm">
          <p class="text-sm font-semibold text-ink">Komende trainingen</p>
          <div class="mt-2 space-y-2">
            {
              trainingen.slice(0, 2).map((t) => (
                <div class="flex gap-2.5">
                  <span class="text-[11px] font-semibold tabular-nums text-[#12813d]">{t.tijd}</span>
                  <span class="min-w-0">
                    <span class="block truncate text-[11px] font-semibold text-ink">{t.naam}</span>
                    <span class="block truncate text-[10px] text-muted">
                      {t.dag} &middot; {t.plek}
                    </span>
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
