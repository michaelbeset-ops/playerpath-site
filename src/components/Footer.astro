---

// Het basispad van de site, zonder slash aan het eind.
// Op GitHub Pages is dat /playerpath-site, lokaal gewoon leeg.
const basis = import.meta.env.BASE_URL.replace(/\/$/, "");
// LET OP: de juridische pagina's bestaan nog niet.
// Maak ze aan of haal de links weg voordat de site live gaat.
const kolommen = [
  {
    titel: "PlayerPath",
    links: [
      { label: "Contact", href: "/#proef-aanvragen" },
      { label: "Tarieven", href: "/#prijs" },
      { label: "Demo inplannen", href: "/#proef-aanvragen" },
      { label: "Over ons", href: "#" },
      { label: "Privacyverklaring", href: "#" },
    ],
  },
  {
    titel: "Functies",
    links: [
      { label: "Planning en agenda", href: "/#planning" },
      { label: "Inschrijven en spelers", href: "/#planning" },
      { label: "Betalingen en facturen", href: "/#betalingen" },
      { label: "Spelerskaart", href: "/#spelerskaart" },
      { label: "Aanwezigheid", href: "/#alles" },
      { label: "Trainers en rechten", href: "/#alles" },
    ],
  },
  {
    titel: "Oplossingen",
    links: [
      { label: "Software voor voetbalscholen", href: "/software-voetbalschool/" },
      { label: "Software voor keeperscholen", href: "/software-keeperschool/" },
      { label: "Spelervolgsysteem", href: "/spelervolgsysteem/" },
      { label: "Inschrijven en incasso", href: "/inschrijven-en-incasso/" },
      { label: "Tarieven", href: "/tarieven/" },
    ],
  },
  {
    titel: "Voor wie",
    links: [
      { label: "Keeperscholen", href: "#" },
      { label: "Voetbalscholen", href: "#" },
      { label: "Techniektraining", href: "#" },
      { label: "Clinics en kampen", href: "#" },
      { label: "Jeugdopleidingen", href: "#" },
    ],
  },
  {
    titel: "Meer weten",
    links: [
      { label: "Hoe het werkt", href: "/#hoe-het-werkt" },
      { label: "Veelgestelde vragen", href: "/#faq" },
      { label: "Demo plannen", href: "/#proef-aanvragen" },
    ],
  },
];

const jaar = new Date().getFullYear();
---

<footer class="bg-ink">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-20">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-8">
      <div class="lg:col-span-1">
        <a href="#" class="inline-flex items-center">
          <img
            src={`${basis}/logo/playerpath-logo-wit.png`}
            alt="PlayerPath"
            width="898"
            height="192"
            class="h-8 w-auto"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/55">
          Je hele voetbalschool in één systeem: planning, inschrijvingen, betalingen
          en een spelerskaart die meegroeit.
        </p>
      </div>

      {
        kolommen.map((kolom) => (
          <div>
            <h2 class="text-sm font-semibold text-white">{kolom.titel}</h2>
            <ul class="mt-4 space-y-2.5">
              {kolom.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-white/55 transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm leading-relaxed text-white/40">
        &copy; {jaar} PlayerPath. Alle rechten voorbehouden.
        <span class="mx-1.5 text-white/20" aria-hidden="true">&middot;</span>
        Een product van{" "}
        <a
          href="https://sitefront.nl"
          class="font-medium text-white/60 underline-offset-4 transition-colors hover:text-accent hover:underline"
        >
          Sitefront
        </a>
        <span class="mx-1.5 text-white/20" aria-hidden="true">&middot;</span>
        KvK 42057398
        <span class="mx-1.5 text-white/20" aria-hidden="true">&middot;</span>
        Dordrecht
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/40">
        <a href="mailto:info@sitefront.nl" class="transition-colors hover:text-accent">
          info@sitefront.nl
        </a>
        <a href="tel:+31643430003" class="transition-colors hover:text-accent">
          06 43 43 00 03
        </a>
      </div>
    </div>
  </div>
</footer>
