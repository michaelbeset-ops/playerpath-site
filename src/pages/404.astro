---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import PitchLines from "../components/PitchLines.astro";

// Een doodlopende pagina hoort de bezoeker verder te helpen, niet alleen te
// melden dat er iets mis is. Vandaar de vier meest bezochte bestemmingen.
const basis = import.meta.env.BASE_URL.replace(/\/$/, "");

const verder = [
  { label: "Naar de homepage", href: `${basis}/` },
  { label: "Tarieven bekijken", href: `${basis}/tarieven/` },
  { label: "Software voor voetbalscholen", href: `${basis}/software-voetbalschool/` },
  { label: "Spelervolgsysteem", href: `${basis}/spelervolgsysteem/` },
];
---

<Layout
  title="Pagina niet gevonden, PlayerPath"
  description="Deze pagina bestaat niet of is verplaatst."
  noindex
>
  <main
    id="hoofdinhoud"
    class="relative isolate flex min-h-svh items-center overflow-hidden bg-ink py-20"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <PitchLines
        class="text-white/[0.06] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,black,transparent_75%)]"
      />
      <div
        class="absolute left-1/2 top-[-16rem] h-[36rem] w-[50rem] -translate-x-1/2 rounded-full bg-accent/[0.12] blur-[140px]"
      >
      </div>
    </div>

    <div class="mx-auto w-full max-w-2xl px-5 text-center sm:px-8">
      <a href={`${basis}/`} class="inline-block">
        <img
          src={`${basis}/logo/playerpath-logo-wit.png`}
          alt="PlayerPath"
          width="898"
          height="192"
          class="mx-auto h-8 w-auto"
        />
      </a>

      <p class="mt-14 text-7xl font-semibold tracking-[-0.04em] text-accent">404</p>
      <h1
        class="mt-4 text-balance text-3xl font-semibold leading-[1.05] tracking-[-0.03em] text-white sm:text-4xl"
      >
        Deze pagina staat buitenspel
      </h1>
      <p class="mx-auto mt-4 max-w-md text-pretty leading-relaxed text-white/60">
        Het adres bestaat niet, of de pagina is verhuisd. Hieronder kom je wel verder.
      </p>

      <ul class="mx-auto mt-9 grid max-w-md gap-2 sm:grid-cols-2">
        {
          verder.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm font-medium text-white/80 transition-colors hover:border-white/25 hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-10">
        <Button href={`${basis}/#proef-aanvragen`}>Plan een demo</Button>
      </div>
    </div>
  </main>
</Layout>
