---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import PitchLines from "../components/PitchLines.astro";

// De pagina waar iemand na het versturen van het formulier belandt.
// Zonder deze pagina toont FormSubmit zijn eigen bedankscherm, en dat voelt
// alsof je van de site af gegooid wordt.
const basis = import.meta.env.BASE_URL.replace(/\/$/, "");

const vervolg = [
  "We kijken welke groepen, tarieven en trainers bij jouw school horen",
  "Je krijgt binnen een werkdag een voorstel voor een moment",
  "In de demo zie je PlayerPath met jouw eigen opzet erin",
];
---

<Layout
  title="Bedankt voor je aanvraag, PlayerPath"
  description="Je aanvraag is binnen. We nemen binnen een werkdag contact met je op."
>
  <main
    id="hoofdinhoud"
    class="relative isolate flex min-h-svh items-center overflow-hidden bg-ink py-20"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <PitchLines
        class="text-white/[0.06] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,black,transparent_75%)]"
      />
      <div
        class="absolute left-1/2 top-[-16rem] h-[38rem] w-[54rem] -translate-x-1/2 rounded-full bg-accent/[0.14] blur-[140px]"
      >
      </div>
    </div>

    <div class="mx-auto w-full max-w-2xl px-5 text-center sm:px-8">
      <img
        src={`${basis}/logo/playerpath-logo-wit.png`}
        alt="PlayerPath"
        width="898"
        height="192"
        class="mx-auto h-8 w-auto"
      />

      <span
        class="mt-12 inline-grid size-16 place-items-center rounded-2xl bg-accent text-ink"
        aria-hidden="true"
      >
        <svg
          class="size-8"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>

      <h1
        class="mt-8 text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.035em] text-white sm:text-5xl"
      >
        Je aanvraag is binnen
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-pretty text-lg leading-relaxed text-white/60">
        Dank je wel. We nemen binnen een werkdag contact met je op, van mens tot mens.
      </p>

      <ol class="mx-auto mt-10 max-w-md space-y-3 text-left">
        {
          vervolg.map((stap, i) => (
            <li class="flex items-start gap-3.5 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-accent/15 text-sm font-semibold text-accent">
                {i + 1}
              </span>
              <span class="text-[15px] leading-relaxed text-white/80">{stap}</span>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 flex flex-col items-center justify-center gap-5 sm:flex-row sm:gap-7">
        <Button href={`${basis}/`}>Terug naar de site</Button>
        <a
          href={`${basis}/#tijdwinst`}
          class="text-[15px] font-semibold text-white/70 transition-colors hover:text-white"
        >
          Reken vast je tijdwinst uit
        </a>
      </div>
    </div>
  </main>
</Layout>
